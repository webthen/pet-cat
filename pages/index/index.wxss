.page {
  --paper: #fbf5ec;
  --ink: #413024;
  --edge: #d9cfc1;
  --focus: #925b36;
  --hover: #eadcc9;
  --muted: #756456;
  --mark: #413024;
  --cloth: #ddcbb2;
  --control: rgba(251, 245, 236, 0.9);
  --chip-bg: #f1e7d8;
  --accent-bg: #e7d4bc;
  --gap: 12rpx;

  min-height: 100vh;
  width: 100%;
  background: var(--paper);
  color: var(--ink);
  user-select: none;
  -webkit-user-select: none;
  transition: background-color 0.2s ease, color 0.2s ease;
}

.page.theme-dark {
  --paper: #101722;
  --ink: #dfebf3;
  --edge: #526276;
  --focus: #b4d9fa;
  --hover: #293546;
  --muted: #a0afbf;
  --mark: #425c75;
  --cloth: #303e50;
  --control: rgba(18, 29, 43, 0.9);
  --chip-bg: #1c2738;
  --accent-bg: #26364c;
}

/* ==================== PORTRAIT SHELL ==================== */
.viewer {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.custom-nav {
  box-sizing: border-box;
  flex: none;
  width: 100%;
  padding-left: 24rpx;
  padding-bottom: 6px;
}

.custom-nav-inner {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-left {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  min-width: 0;
}

.nav-cat-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.5rpx;
}

.nav-cat-index {
  font-size: 22rpx;
  color: var(--muted);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: none;
}

.nav-pill {
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--chip-bg);
  border: 1px solid var(--edge);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.nav-pill.is-active {
  background: var(--hover);
  border-color: var(--focus);
}

.nav-pill-icon {
  width: 30rpx;
  height: 30rpx;
}

.nav-pill-label {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink);
}

/* ==================== STAGE PLAYFIELD ==================== */
.playfield {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 6rpx var(--gap);
  box-sizing: border-box;
}

.stage {
  position: relative;
  width: 100%;
  aspect-ratio: 1.42;
  max-height: calc(100% - 48rpx);
  border-radius: 26rpx;
  overflow: hidden;
  background: var(--cloth);
  transition: aspect-ratio 0.2s ease;
}

.stage.is-closeup {
  aspect-ratio: 1.04;
  max-height: calc(100% - 46rpx);
}

.scene-canvas {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.18s ease;
}

.stage.is-ready .scene-canvas {
  opacity: 1;
}

.stage-caption {
  margin-top: 14rpx;
  padding: 0 16rpx;
  text-align: center;
}

.stage-caption-text {
  font-size: 22rpx;
  color: var(--muted);
  opacity: 0.9;
}

/* ==================== PORTRAIT BOTTOM DOCK ==================== */
.bottom-dock {
  flex: none;
  width: 100%;
  padding-top: 6rpx;
  padding-bottom: max(22rpx, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.breed-strip-wrap {
  position: relative;
  width: 100%;
  height: 98rpx;
}

.breed-strip {
  width: 100%;
  height: 98rpx;
  white-space: nowrap;
}

.breed-list {
  display: inline-flex;
  align-items: center;
  height: 98rpx;
  padding: 0 42rpx 0 20rpx;
}

.breed-item {
  position: relative;
  flex: none;
  width: 82rpx;
  height: 82rpx;
  margin-right: 14rpx;
  padding: 4rpx;
  border-radius: 50%;
  border: 2px solid transparent;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: border-color 0.15s ease, transform 0.12s ease;
}

.breed-item:last-child {
  margin-right: 0;
}

.breed-item.is-selected {
  border-color: var(--ink);
  transform: scale(1.06);
}

.breed-fade-right {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 98rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(251, 245, 236, 0) 0%, var(--paper) 92%);
}

.theme-dark .breed-fade-right {
  background: linear-gradient(90deg, rgba(16, 23, 34, 0) 0%, var(--paper) 92%);
}

.coat-wrap {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  overflow: hidden;
  background: #e3d9ca;
  box-shadow: inset 0 0 0 1px rgba(51, 40, 30, 0.24);
}

.theme-dark .coat-wrap {
  box-shadow: inset 0 0 0 1px rgba(184, 201, 223, 0.3);
}

.coat-img {
  width: 100%;
  height: 100%;
  display: block;
}

.check-badge {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 2px solid var(--paper);
  background: var(--mark);
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-img {
  width: 16rpx;
  height: 16rpx;
}

/* Circular icon + micro-label tool bar in portrait */
.tool-bar {
  width: 100%;
  padding: 2rpx 28rpx 4rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  box-sizing: border-box;
}

.tool-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 108rpx;
}

.tool-circle {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--chip-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1px rgba(146, 91, 54, 0.08);
  transition: background-color 0.15s ease, transform 0.12s ease;
}

.tool-action.tool-action-accent .tool-circle {
  background: var(--accent-bg);
  box-shadow: inset 0 0 0 1px var(--edge);
}

.tool-action.is-active .tool-circle {
  background: var(--hover);
  box-shadow: inset 0 0 0 1.5px var(--focus);
}

.tool-circle-icon {
  width: 38rpx;
  height: 38rpx;
}

.tool-label {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--muted);
  white-space: nowrap;
}

.tool-action.is-active .tool-label,
.tool-action.tool-action-accent .tool-label {
  color: var(--ink);
}

/* Retry icon button when load failed */
.icon-button {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: transparent;
}

.svg-icon {
  width: 38rpx;
  height: 38rpx;
}

.retry-btn {
  position: absolute;
  z-index: 4;
  bottom: 20rpx;
  left: 20rpx;
  background: var(--paper);
  box-shadow: inset 0 0 0 1px var(--edge);
}

/* ==================== HINT TOAST ==================== */
.hint-toast {
  position: fixed;
  bottom: 248rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(25, 19, 14, 0.72);
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  z-index: 6;
  pointer-events: none;
  animation: fadeInOut 4.4s ease forwards;
}

.hint-toast-text {
  font-size: 23rpx;
  color: #fff;
  white-space: nowrap;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translateX(-50%) translateY(10rpx); }
  12% { opacity: 1; transform: translateX(-50%) translateY(0); }
  78% { opacity: 1; }
  100% { opacity: 0; }
}

/* ==================== PROPORTIONS PANEL ==================== */
.panel-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9;
}

.proportions-panel {
  position: fixed;
  z-index: 10;
  bottom: 248rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 540rpx;
  max-width: calc(100vw - 48rpx);
  padding: 18rpx 22rpx;
  background: var(--paper);
  color: var(--ink);
  border: 1px solid var(--edge);
  border-radius: 32rpx;
  box-shadow: 0 8rpx 36rpx rgba(33, 23, 12, 0.16);
}

.proportion-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 84rpx;
}

.cat-shape-icon {
  width: 60rpx;
  height: 60rpx;
  flex: none;
}

.slider-wrap {
  position: relative;
  flex: 1;
  min-width: 0;
}

.slider-mid-tick {
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  width: 4rpx;
  height: 10rpx;
  transform: translateX(-50%);
  border-radius: 2rpx;
  background: var(--muted);
  pointer-events: none;
}

.prop-slider {
  margin: 0 8rpx;
}

/* ==================== NATIVE WIDE / LANDSCAPE VIEWPORT ==================== */
@media (min-aspect-ratio: 11/10) {
  .viewer:not(.soft-rotated) {
    max-width: 1200px;
    margin: 0 auto;
    justify-content: space-between;
  }

  .viewer:not(.soft-rotated) .stage {
    aspect-ratio: 1517 / 935;
    max-height: calc(100vh - 104px);
    width: auto;
    max-width: 100%;
  }

  .viewer:not(.soft-rotated) .bottom-dock {
    flex-direction: row;
    align-items: center;
    padding: 8rpx 20rpx max(12rpx, env(safe-area-inset-bottom));
    gap: 14rpx;
  }

  .viewer:not(.soft-rotated) .breed-strip-wrap {
    flex: 1;
    height: 78rpx;
  }

  .viewer:not(.soft-rotated) .breed-strip {
    height: 78rpx;
  }

  .viewer:not(.soft-rotated) .breed-list {
    height: 78rpx;
    padding: 0 28rpx 0 8rpx;
  }

  .viewer:not(.soft-rotated) .breed-item {
    width: 66rpx;
    height: 66rpx;
    margin-right: 10rpx;
  }

  .viewer:not(.soft-rotated) .breed-fade-right {
    height: 78rpx;
  }

  .viewer:not(.soft-rotated) .tool-bar {
    flex: none;
    width: auto;
    padding: 0;
    gap: 10rpx;
  }

  .viewer:not(.soft-rotated) .tool-action {
    min-width: 68rpx;
    gap: 2rpx;
  }

  .viewer:not(.soft-rotated) .tool-circle {
    width: 56rpx;
    height: 56rpx;
  }

  .viewer:not(.soft-rotated) .tool-circle-icon {
    width: 30rpx;
    height: 30rpx;
  }

  .viewer:not(.soft-rotated) .proportions-panel {
    left: auto;
    right: 24rpx;
    bottom: 104px;
    transform: none;
  }
}

/* Native landscape fullscreen toggle (already rotated device) */
.viewer.landscape:not(.soft-rotated) {
  position: fixed;
  inset: 0;
  z-index: 8;
  max-width: none;
  width: 100vw;
  height: 100vh;
  background: var(--paper);
  padding: max(12rpx, env(safe-area-inset-top)) max(16rpx, env(safe-area-inset-right)) max(10rpx, env(safe-area-inset-bottom)) max(16rpx, env(safe-area-inset-left));
  box-sizing: border-box;
}

.viewer.landscape:not(.soft-rotated) .playfield {
  flex: 1;
  min-height: 0;
  padding: 0;
}

.viewer.landscape:not(.soft-rotated) .stage {
  height: 100%;
  width: auto;
  max-width: 100%;
  max-height: none;
  aspect-ratio: 2 / 1;
}

/* ==================== SOFTWARE ROTATED FULLSCREEN LANDSCAPE ==================== */
.viewer.soft-rotated {
  position: fixed;
  inset: 0;
  z-index: 8;
  width: 100vw;
  height: 100vh;
  background: var(--paper);
  flex-direction: row-reverse;
  align-items: stretch;
  padding: max(16rpx, env(safe-area-inset-top)) max(12rpx, env(safe-area-inset-right)) max(18rpx, env(safe-area-inset-bottom)) max(10rpx, env(safe-area-inset-left));
  gap: 10rpx;
  box-sizing: border-box;
}

.viewer.soft-rotated .playfield {
  flex: 1;
  min-width: 0;
  min-height: 0;
  padding: 0;
}

.viewer.soft-rotated .stage {
  height: 100%;
  width: 100%;
  max-height: none;
  aspect-ratio: auto;
  border-radius: 22rpx;
}

.viewer.soft-rotated .retry-btn {
  bottom: auto;
  top: 18rpx;
  left: 18rpx;
}

.soft-rotated-bar {
  flex: none;
  width: 92rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0 8rpx;
  gap: 10rpx;
  box-sizing: border-box;
}

.breed-strip-vert {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.breed-list-vert {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
  gap: 10rpx;
}

.soft-rotated-bar .breed-item {
  width: 60rpx;
  height: 60rpx;
  margin-right: 0;
  padding: 3rpx;
}

.soft-tool-group {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.soft-tool-btn {
  width: 74rpx;
  height: 74rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 20rpx;
  background: var(--chip-bg);
}

.soft-tool-btn.soft-tool-exit {
  background: var(--accent-bg);
  box-shadow: inset 0 0 0 1px var(--edge);
}

.soft-tool-btn.is-active {
  background: var(--hover);
  box-shadow: inset 0 0 0 1.5px var(--focus);
}

.soft-tool-icon {
  width: 32rpx;
  height: 32rpx;
}

.soft-tool-label {
  font-size: 17rpx;
  font-weight: 500;
  color: var(--ink);
  line-height: 1.1;
}

.rotated-icon {
  transform: rotate(90deg);
}

.proportions-panel.rotated-panel {
  left: 280rpx;
  top: 50%;
  bottom: auto;
  transform: rotate(90deg) translateX(-50%);
  transform-origin: 0 0;
}
